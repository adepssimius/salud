meta {
  name: Revoke Snapshot
  type: http
  seq: 6
}

delete {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}er-brief/snapshots/{{snapshotId}}
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  {{snapshotId}} comes from either "Create Snapshot" (which now returns `id` alongside the token,
  so a caller can revoke the link it just made) or "List Snapshots".

  The token itself is still never re-surfaced after creation — the list exists to let a link be
  found and killed, not copied again.
}
