meta {
  name: Create Snapshot
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/er-brief/snapshots
  body: json
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest('patients/list');
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

body:json {
  {
    "expiresInHours": 72
  }
}

script:post-response {
  bru.setVar('token', res.body.token);
  bru.setVar('snapshotId', res.body.id);
}

assert {
  id: isNotEmpty
  token: isNotEmpty
  url: isNotEmpty
  expiresAt: isNotEmpty
}

docs {
  `url` is derived server-side: host from the request's own Host header, scheme from
  X-Forwarded-Proto behind the trusted proxy and forced to https in production. A client-supplied
  Origin header is ignored — this is a bearer capability to a complete medical brief.

  `id` is returned so the link can be revoked without re-listing; revoke-snapshot picks it up.
}

settings {
  encodeUrl: true
  timeout: 0
}
