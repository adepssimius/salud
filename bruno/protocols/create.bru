meta {
  name: Create Protocol
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}conditions/{{conditionId}}/protocols
  body: json
  auth: inherit
}

script:pre-request {
  let cid = bru.getVar('conditionId');
  if (!cid) {
    const createReq = await bru.runRequest('conditions/create');
    cid = createReq.data.id;
  }
  bru.setVar('conditionId', cid);
}

body:json {
  {
    "name": "Fever with port",
    "triggerMetric": "temperature",
    "triggerOperator": "gte",
    "triggerValue": 38,
    "instructionText": "ER immediately, do not give antipyretics first",
    "sourceText": "Dr. Okafor, 2026-03-01"
  }
}

script:post-response {
  bru.setVar('protocolId', res.body.id);
}

assert {
  id: isNotEmpty
  active: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
