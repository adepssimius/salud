meta {
  name: Get Care Documents
  type: http
  seq: 1
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/care-documents
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest('patients/list');
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  All three keys are always present. `null` means "never recorded" and is deliberately different
  from a statement with `status: "none"` — see api.md → Care documents.
}
