meta {
  name: Create Condition
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/conditions
  body: json
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest('patients/list');
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

body:json {
  {
    "name": "ALL treatment",
    "diagnosisText": "Acute lymphoblastic leukemia",
    "status": "active",
    "baselines": ["resting HR runs 110", "always has a rattly cough"],
    "devices": ["port"],
    "contacts": [
      { "name": "Dr. Okafor", "role": "Oncologist", "phone": "555-1234" }
    ]
  }
}

script:post-response {
  bru.setVar('conditionId', res.body.id);
}

assert {
  id: isNotEmpty
  status: eq active
}

settings {
  encodeUrl: true
  timeout: 0
}
