meta {
  name: Get Episode
  type: http
  seq: 3
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}episodes/{{episodeId}}
  body: none
  auth: inherit
}

script:pre-request {
  let eid = bru.getVar('episodeId');
  if (!eid) {
    const listReq = await bru.runRequest("episodes/list");
    const list = listReq.data;
    if (Array.isArray(list) && list.length) {
      eid = list[0].id;
    }
  }
  bru.setVar('episodeId', eid);
}

assert {
  id: isNotEmpty
  observationIds: isDefined
  interventionIds: isDefined
  startedAt: isDefined
  endedAt: isDefined
  schedules: isArray
  medications: isArray
}

docs {
  The single-episode read. Besides the ids it carries `schedules` (every schedule filed under this
  episode, each with computed `adherence` — `expectedCount` capped at the course's end) and
  `medications` (`{ id, name, embodiments: [{ id, label, dosageForm }] }` for every medicine a member
  dose or one of those schedules names). Both are `[]` when there are none. See app-spec/api.md →
  Episodes.
}

settings {
  encodeUrl: true
  timeout: 0
}
