meta {
  name: Get Episode
  type: http
  seq: 3
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}episodes/{{episodeId}}
  body: none
  auth: inherit
}

script:pre-request {
  let eid = bru.getVar('episodeId');
  if (!eid) {
    const listReq = await bru.runRequest("episodes/list");
    const list = listReq.data;
    if (Array.isArray(list) && list.length) {
      eid = list[0].id;
    }
  }
  bru.setVar('episodeId', eid);
}

assert {
  id: isNotEmpty
  observationIds: isDefined
  interventionIds: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
