meta {
  name: Add Or Remove Episode Entries
  type: http
  seq: 5
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}episodes/{{episodeId}}/events
  body: json
  auth: inherit
}

body:json {
  {
    "add": [
      { "type": "observation", "id": "{{observationId}}" }
    ],
    "remove": []
  }
}

docs {
  Adding a member or removing a non-member is a no-op. The start always follows the earliest
  member: adding an earlier entry makes it the start, and removing the start promotes the
  next-earliest. Removing every member is 400 EPISODE_LAST_ENTRY; leaving a resolved episode's
  resolving entry earlier than all its other members is 400 EPISODE_TIME_ORDER_INVALID. Removing the
  entry that resolved it reopens the episode.
}

settings {
  encodeUrl: true
  timeout: 0
}
