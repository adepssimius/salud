meta {
  name: Ack What's New
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/whats-new/ack
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

assert {
  ackedAt: isNotEmpty
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Advances the caller's watermark to now. Run "Get What's New" again afterward — the diff should
  be empty until something new happens.
}
