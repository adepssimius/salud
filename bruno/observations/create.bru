meta {
  name: Create Observation
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/observations
  body: json
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId') || bru.getVar('randPatientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
  bru.setVar('observedAt', new Date().toISOString());
}

body:json {
  {
    "observedAt": "{{observedAt}}",
    "startEpisodeName": "Bruno Episode",
    "episodeIds": [],
    "resolvesEpisodeIds": [],
    "unitPreferenceAtEntry": { "temp": "F", "weight": "lb", "length": "in" },
    "entries": [
      { "type": "temperature", "metadata": { "value": 38.1, "unit": "C", "method": "oral" } },
      { "type": "weight", "metadata": { "kg": 11.34 } }
    ]
  }
}

script:post-response {
  bru.setVar('observationId', res.body.id);
  if (res.body.episodeIds && res.body.episodeIds.length) {
    bru.setVar('episodeId', res.body.episodeIds[0]);
  }
}

assert {
  id: isNotEmpty
  res.body.unitPreferenceAtEntry.temp: eq F
  res.body.unitPreferenceAtEntry.weight: eq lb
  res.body.unitPreferenceAtEntry.length: eq in
}

settings {
  encodeUrl: true
  timeout: 0
}
