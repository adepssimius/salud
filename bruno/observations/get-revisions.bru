meta {
  name: Get Observation Revisions
  type: http
  seq: 4
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}observations/{{observationId}}/revisions
  body: none
  auth: inherit
}

script:pre-request {
  let oid = bru.getVar('observationId');
  if (!oid) {
    const listReq = await bru.runRequest("observations/list");
    const list = listReq.data;
    if (Array.isArray(list) && list.length) {
      oid = list[0].id;
    }
  }
  bru.setVar('observationId', oid);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Newest first. A freshly-created observation has none — PATCH
  {{apiPrefix}}observations/{{observationId}} at least once first to populate a revision
  (data-model.md → "Revision").
}
