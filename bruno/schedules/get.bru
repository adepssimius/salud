meta {
  name: Get Schedule
  type: http
  seq: 3
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}schedules/{{scheduleId}}
  body: none
  auth: inherit
}

script:pre-request {
  let sid = bru.getVar('scheduleId');
  if (!sid) {
    const listReq = await bru.runRequest('schedules/list');
    const list = listReq.data;
    if (Array.isArray(list) && list.length) sid = list[0].id;
  }
  bru.setVar('scheduleId', sid);
}

assert {
  adherence: isDefined
  res.body.adherence.courseEndsAt: isDefined
}

docs {
  adherence.courseEndsAt is when the course's last planned dose falls (epoch seconds), counted on
  from the next dose as the plan stands — "give every dose" skips push it out. null when the
  schedule is open-ended, completed or paused (data-model.md → ScheduleAdherence).
}

settings {
  encodeUrl: true
  timeout: 0
}
