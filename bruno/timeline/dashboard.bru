meta {
  name: Get Dashboard
  type: http
  seq: 2
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}dashboard
  body: none
  auth: inherit
}

assert {
  lastDoses: isDefined
  whatsNew: isDefined
  activeEpisodes: isDefined
  upcomingSchedules: isDefined
  shoppingList: isDefined
  unacknowledgedAdvisories: isDefined
  recentTemperatures: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
