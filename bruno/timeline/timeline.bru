meta {
  name: Get Timeline
  type: http
  seq: 1
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/timeline
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId') || bru.getVar('randPatientId');
  if (!pid) {
    const patientsReq = await bru.runRequest('patients/list');
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

assert {
  patient: isDefined
  entries: isDefined
  weightPrompt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
