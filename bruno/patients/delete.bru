meta {
  name: Delete Patient
  type: http
  seq: 5
}

delete {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}
  body: none
  auth: inherit
}

vars:pre-request {
  ~patientId: d85d5367-ce33-4d91-a955-9345f67dec99
}

script:pre-request {
  const patientId = bru.getRequestVar('patientId')
  
  if (patientId) return bru.setVar('patientId', patientId);
  
  console.log("No patientId set. Getting a random one.");
  const patientsReq = await bru.runRequest("patients/list");
  const patients = patientsReq.data;
  const patient = patients[Math.floor(Math.random()*patients.length)];
  console.log("got patient " + patient.id);
  bru.setVar('patientId', patient.id);
  
}

assert {
  res.status: eq 200
  res.body.deleted: eq true
}

docs {
  Owner-only, and it cascades: every observation, dose, episode, condition, schedule, reaction,
  advisory, snapshot, revision and file for the patient goes with it, blobs included.

  A care team member who is not `ownedById` gets 403 `NOT_PATIENT_OWNER`; a non-member still gets
  404 `PATIENT_NOT_FOUND`. Neither is exercised here — Bruno has no second-identity story in this
  collection, so both are covered by `patients.e2e-spec.ts` instead.
}

settings {
  encodeUrl: true
  timeout: 0
}
