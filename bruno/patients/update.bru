meta {
  name: Update Patient
  type: http
  seq: 4
}

patch {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}users/{{userId}}/patients/{{patientId}}
  body: json
  auth: inherit
}

body:json {
  {
    "notes": "Updated notes"
  }
}

vars:pre-request {
  patientId: 56724eb6-29c3-4c28-9f8c-49aa0142ec9a
}

script:pre-request {
