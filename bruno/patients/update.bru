meta {
  name: Update Patient
  type: http
  seq: 4
}

patch {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}
  body: json
  auth: inherit
}

body:json {
  {
    "notes": "Updated notes"
  }
}

vars:pre-request {
  ~patientId: d85d5367-ce33-4d91-a955-9345f67dec99
}

script:pre-request {
  let pid = bru.getRequestVar('patientId') || bru.getVar('patientId') || bru.getVar('randPatientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

settings {
  encodeUrl: true
  timeout: 0
}
