meta {
  name: Get Patient
  type: http
  seq: 3
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId') || bru.getVar('randPatientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Fetches a single patient. If no patientId var is set, it falls back to List Patients and uses the
  first result, so this request works standalone.
}
