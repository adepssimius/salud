meta {
  name: Dose Check (preview)
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/dose-checks
  body: json
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId') || bru.getVar('randPatientId');
  if (!pid) {
    const patientsReq = await bru.runRequest('patients/list');
    const patients = patientsReq.data;
    if (patients.length) pid = patients[0].id;
  }
  bru.setVar('patientId', pid);

  let mid = bru.getVar('medicationId');
  if (!mid) {
    const listReq = await bru.runRequest('medications/list');
    const list = listReq.data;
    if (Array.isArray(list) && list.length) mid = list[0].id;
  }
  bru.setVar('medicationId', mid);
}

body:json {
  {
    "medicationId": "{{medicationId}}",
    "amountMg": 150
  }
}

assert {
  guidance: isDefined
  advisories: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Preview only; persists nothing. Body: `medicationId`, and optionally `medicationEmbodimentId`,
  `amountMg`, `occurredAt` (ISO; defaults to now) and `excludeInterventionId` (UUID).

  The dose correction form sends `excludeInterventionId` with the id of the dose being corrected,
  so the preview leaves that dose out of the interval and daily-total checks, as the correcting
  `PATCH /api/interventions/:interventionId` does. An id that isn't one of this patient's doses is
  ignored. For example:

  { "medicationId": "{{medicationId}}", "amountMg": 150, "excludeInterventionId": "{{interventionId}}" }
}
