meta {
  name: Create Reference Range
  type: http
  seq: 7
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}analytes/{{analyteId}}/reference-ranges
  body: json
  auth: inherit
}

body:json {
  {
    "refLow": 38,
    "refHigh": 380,
    "effectiveFrom": "2026-07-20T09:10:00.000Z",
    "source": "Quest report AB123456C"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('referenceRangeId', res.body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Reference ranges are effective-dated: the one in effect at time t is the row with the greatest
  effectiveFrom at or before t, so a result recorded years ago keeps being read against the
  standard that applied when the specimen was drawn. At least one of refLow/refHigh/refText is
  required (400 ANALYTE_RANGE_EMPTY). Retry-safe: posting values identical to the row already in
  effect returns that row instead of stacking a duplicate.
}
