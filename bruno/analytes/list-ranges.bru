meta {
  name: List Ranges
  type: http
  seq: 8
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/analytes/{{analyteId}}/ranges
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients && patients.length) {
      bru.setVar('patientId', patients[0].id);
    } else {
      console.log('No patients found. Create one first.');
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  This patient's ranges for this analyte — every lineage, newest effectiveFrom first. Another
  patient's ranges for the same analyte are a separate set: the analyte is shared, the standards
  are not. 404 PATIENT_NOT_FOUND to a non-member.
}
