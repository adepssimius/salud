meta {
  name: Analyte History
  type: http
  seq: 14
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/analytes/{{analyteId}}/history
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Everything the history chart needs in one request: the analyte, its full range history
  (ascending), this patient's goal, and every recorded value of it for this patient (ascending,
  epoch seconds). Non-members get 404 PATIENT_NOT_FOUND.
}
