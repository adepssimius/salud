meta {
  name: List Patient Goals
  type: http
  seq: 11
}

get {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/analyte-goals
  body: none
  auth: inherit
}

script:pre-request {
  let pid = bru.getVar('patientId');
  if (!pid) {
    const patientsReq = await bru.runRequest("patients/list");
    const patients = patientsReq.data;
    if (patients && patients.length) {
      bru.setVar('patientId', patients[0].id);
    } else {
      console.log('No patients found. Create one first.');
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Goals are per-patient, unlike the analyte itself: a ferritin target set for an adult athlete
  has nothing to do with a child's labs. Each row carries the analyte's displayName for
  rendering. Non-members get 404 PATIENT_NOT_FOUND.
}
