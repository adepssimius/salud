meta {
  name: Set Patient Goal
  type: http
  seq: 12
}

put {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}patients/{{patientId}}/analyte-goals/{{analyteId}}
  body: json
  auth: inherit
}

body:json {
  {
    "goalLow": 120,
    "note": "athletic target — in range is not the same as at goal"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Upsert: one goal per (patient, analyte). At least one of goalLow/goalHigh is required
  (400 ANALYTE_GOAL_EMPTY). A goal never computes a flag onto the record — it is display-only
  context the caregiver set for themselves.
}
