meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "testpassword"
  }
}

assert {
  token: isNotEmpty
}

settings {
  encodeUrl: true
  timeout: 0
}
