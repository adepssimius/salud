meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test1@example.com",
    "password": "testpassword",
    "displayName": "Test User",
    "preferredTempUnit": "F",
    "preferredLengthUnit": "cm",
    "preferredWeightUnit": "kg"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
