meta {
  name: Create Embodiment
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}:{{port}}/{{apiPrefix}}medications/{{medicationId}}/embodiments
  body: json
  auth: inherit
}

script:pre-request {
  let mid = bru.getVar('medicationId');
  if (!mid) {
    const listReq = await bru.runRequest('medications/list');
    const list = listReq.data;
    if (Array.isArray(list) && list.length) mid = list[0].id;
  }
  bru.setVar('medicationId', mid);
}

body:json {
  {
    "label": "500 mg tablet",
    "strengthMgPerUnit": 500,
    "unitType": "tablet",
    "atHome": true,
    "runningLow": false
  }
}

script:post-response {
  bru.setVar('embodimentId', res.body.id);
}

assert {
  id: isNotEmpty
  atHome: eq true
}

docs {
  Create accepts the same cabinet fields PATCH does — `atHome`, `expiresAt`, `runningLow`. They
  used to be update-only, so `whitelist: true` silently stripped them here and the caller got a 201
  with both flags false. `runningLow: true` stamps the attribution from the requesting user, same
  as PATCH.
}

settings {
  encodeUrl: true
  timeout: 0
}
