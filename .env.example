# Salud API configuration. Every value here is optional: with none of them set the API runs the
# zero-config self-host path — SQLite at ./data/salud.db, attachments on local disk under
# ./data/attachments. Copy to .env only if you need to override something.
#
# app-spec/persistence.md is the authoritative reference; app-spec/deployment.md has the
# production values for salud.bpd.sh.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# NODE_ENV=production switches on the fail-fast checks: a missing/weak JWT_SECRET and an
# unwritable DATA_DIR refuse to boot rather than degrade silently.
# NODE_ENV=development
# PORT=3000

# Base directory for local state — the SQLite file and, under the local storage driver,
# the attachments tree. Defaults to ./data outside production, /data in a container.
# DATA_DIR=/data

# Required in production; must be at least 32 characters.
# JWT_SECRET=

# ---------------------------------------------------------------------------
# Database — sqlite (default) | postgres
# ---------------------------------------------------------------------------
# Both are fully supported deployment targets, not one real and one fallback.
# DB_CLIENT=sqlite
# DATABASE_FILE=$DATA_DIR/salud.db          # sqlite only
# DATABASE_URL=postgres://user:pass@host:5432/salud   # required when DB_CLIENT=postgres

# ---------------------------------------------------------------------------
# File storage — local (default) | s3
# ---------------------------------------------------------------------------
# Anything other than local/s3 refuses to boot, as does s3 without S3_BUCKET.
#
# Note: switching drivers on a populated instance is a data migration, not a config change.
# Reads always resolve through the configured driver; nothing dual-reads file_assets.bucket, so
# flipping this without copying the blobs across leaves existing attachments unreadable.
# FILE_STORAGE_DRIVER=local

# local driver
# FILE_STORAGE_LOCAL_BASE_PATH=$DATA_DIR/attachments

# s3 driver — targets the S3 API, not AWS specifically. Leave S3_ENDPOINT unset for real AWS;
# set it for Ceph RGW, MinIO, Cloudflare R2, Backblaze B2, etc.
# S3_BUCKET=salud-attachments
# S3_REGION=us-east-1                        # default; what Ceph RGW and MinIO expect
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true                   # defaults true when S3_ENDPOINT is set
# S3_PREFIX=salud/attachments/               # optional key prefix within the bucket
# Both or neither. Leaving both unset falls through to the AWS default credential chain
# (IRSA, instance profile, ~/.aws/credentials).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# ACCESS_LOG=false                           # disables the HTTP access log
# SLOW_REQUEST_MS=1000                       # requests at or over this log at warn, tagged SLOW

# ---------------------------------------------------------------------------
# OIDC login (Authelia) — see app-spec/deployment.md
# ---------------------------------------------------------------------------
# OIDC_ENABLED=true
# AUTHELIA_ISSUER_URL=https://auth.bpd.sh
# OIDC_CLIENT_ID=salud
# OIDC_CLIENT_SECRET=
# OIDC_REQUIRED_GROUP=salud_users
